# Inlines local #include "..." lines of the Metal kernel source (searching
# INCLUDE_DIRS, recursively) and writes a C++ header holding it as one string.
#   cmake -DINPUT=... -DOUTPUT=... -DINCLUDE_DIRS="a|b" -P embed_msl.cmake
cmake_minimum_required(VERSION 3.20)
string(REPLACE "|" ";" dirs "${INCLUDE_DIRS}")

file(READ "${INPUT}" src)
set(done "")
foreach(pass RANGE 60)
  string(REGEX MATCH "#include \"([^\"]+)\"" m "${src}")
  if(NOT m)
    break()
  endif()
  set(name "${CMAKE_MATCH_1}")
  # Headers are include-guarded; inline every occurrence (fg3d_trace.h is meant to
  # be included twice).
  set(body "")
  if(TRUE)
    set(found "")
    foreach(dir IN LISTS dirs)
      if(NOT found AND EXISTS "${dir}/${name}")
        set(found "${dir}/${name}")
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "embed_msl: cannot find ${name}")
    endif()
    file(READ "${found}" body)
    list(APPEND done "${name}")
  endif()
  string(FIND "${src}" "${m}" pos)
  string(LENGTH "${m}" len)
  string(SUBSTRING "${src}" 0 ${pos} head)
  math(EXPR tailpos "${pos} + ${len}")
  string(SUBSTRING "${src}" ${tailpos} -1 tail)
  set(src "${head}${body}${tail}")
endforeach()

set(content "// Generated from fg3d_metal_kernels.metal by cmake/embed_msl.cmake. Do not edit.\n#pragma once\nstatic const char* kFG3DMetalSource = R\"FGMSL(\n${src})FGMSL\";\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
